# Environment variables example for the gaming website
# Copy this file to .env and fill in the values before running

# Next.js app URL (used by GitHub OAuth callback)
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# For NextAuth the callback will be: ${NEXTAUTH_URL}/api/auth/callback/github

# A short code users can enter to register as admin (keep secret)
ADMIN_REG_CODE=replace_with_a_random_code

# Optionally set an initial admin email to automatically promote that GitHub account on first sign-in
# Example: INITIAL_ADMIN_EMAIL=youremail@example.com
INITIAL_ADMIN_EMAIL=jackeichelberger3@gmail.com

# Control iframe embeds: set to true to allow iframes at all (still filtered by ALLOWED_IFRAME_HOSTS)
ALLOW_IFRAME=false
# Comma-separated host allowlist for iframe src attributes (example: youtube.com,itch.io)
ALLOWED_IFRAME_HOSTS=youtube.com,itch.io

# Prisma database file (SQLite)
DATABASE_URL="file:./dev.db"
